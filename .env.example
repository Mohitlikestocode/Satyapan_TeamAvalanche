# Copy to .env (git-ignored) and fill in. Never commit real values.

# --- public site ---------------------------------------------------------------------------------------------
# Address Caddy serves over HTTPS: your domain, or <server-ip>.sslip.io if you have no domain.
SITE_ADDRESS=example.invalid
# Full public address, used in links the bot and the posters print.
PUBLIC_URL=https://example.invalid

# --- protection (the Docker image already sets RATE_LIMIT=1, TRUST_PROXY=1, PUBLIC_HTTPS=1) --------------
RATE_LIMIT=1
RATE_CHECKS_PER_MIN=20
RATE_REQUESTS_PER_MIN=300
MAX_UPLOAD_MB=25
TRUST_PROXY=1
PUBLIC_HTTPS=1

# --- counting real users honestly ----------------------------------------------------------------------------
# Team members open https://<site>/internal?key=<this value> once per browser so their test traffic is not counted.
INTERNAL_KEY=change-me-to-a-long-random-string
# Optional: fixed salt for hashing device ids. If empty a random one is created in /data/keys.
METRICS_SALT=

# --- Telegram bot (create with @BotFather, then /newbot) ---------------------------------------------------
TELEGRAM_BOT_TOKEN=

# --- Sarvam text-to-speech (free credits; speaks only our template text) --------------------------------
SARVAM_API_KEY=

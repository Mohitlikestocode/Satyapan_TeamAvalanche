# Copy to .env (gitignored). Never commit real values.
SATYAPAN_PROFILE=laptop          # laptop | gpu
SATYAPAN_OFFLINE=1               # 1 = no network look-ups at all
# SATYAPAN_HOME=./var
# TELEGRAM_BOT_TOKEN=            # from @BotFather; optional (web simulator needs none)
# SATYAPAN_MASTER_KEY=           # base64 32 bytes; auto-generated into var/keys on first run if unset
# SATYAPAN_CHAT_SALT=            # base64; auto-generated on first run if unset
# OPTIONAL and OFF: Sarvam AI adapter (never in demo/offline mode; sends audio/text to a third party). Leave empty.
# SATYAPAN_SARVAM=1
# SARVAM_API_KEY=
